{
    "version": 2,
    "installCommand": "composer install --no-dev --prefer-dist --optimize-autoloader && npm install && npm run build",
    "buildCommand": "npm run build",
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "DB_CONNECTION": "pgsql",
        "DB_SSLMODE": "require",
        "LARAVEL_STORAGE_PATH": "/tmp/form-custom-storage",
        "VIEW_COMPILED_PATH": "/tmp/form-custom-storage/framework/views",
        "APP_CONFIG_CACHE": "/tmp/form-custom-storage/framework/cache/config.php",
        "APP_EVENTS_CACHE": "/tmp/form-custom-storage/framework/cache/events.php",
        "APP_PACKAGES_CACHE": "/tmp/form-custom-storage/framework/cache/packages.php",
        "APP_ROUTES_CACHE": "/tmp/form-custom-storage/framework/cache/routes.php",
        "APP_SERVICES_CACHE": "/tmp/form-custom-storage/framework/cache/services.php"
    },
    "builds": [
        {
            "src": "api/*.php",
            "use": "vercel-php@0.8.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/_health",
            "dest": "/api/health.php"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
